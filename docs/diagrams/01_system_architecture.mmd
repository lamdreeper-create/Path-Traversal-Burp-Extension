    MAINTAB --> RES_TBL
    MAINTAB --> EDITORS
    MAINTAB --> REPEATER
    INPUT_TBL --> SCAN_MGR
    SCAN_MGR --> INPUT_MGR
    SCAN_MGR --> CTX_BUILDER
    SCAN_MGR --> BASE_ENG
